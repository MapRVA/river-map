---
type: javascript
options:
  bounds: [-77.52485275268559,37.508091780419434,-77.40812301635748,37.55464854230685]
  maxBounds: [-77.56793975830084,37.494064605987006,-77.36383438110356,37.598184102020234]
  zoom: 12
style:
  layers:
    - type: line
      filter: [==, [geometry-type], LineString]
      line-color: gray
      line-opacity: 0.5
      line-width: 3
      beforeLayerId: building
    - type: fill
      filter: [==, [geometry-type], Polygon]
      fill-color: gray
      fill-opacity: 0.5
      beforeLayerId: building
    - type: symbol
      filter: [==, [get, type], test]
      icon-image: pinhead:circle
      icon-overlap: always
      icon-opacity:
        - interpolate
        - [linear]
        - [to-number, [get, age]]
        - 0
        - 1
        - 30
        - 0
      icon-color:
        - case
        - [">=", [to-number, [get, Ecoli]], 235]
        - red
        - [">=", [to-number, [get, Ecoli]], 100]
        - yellow
        - green
    - type: symbol
      filter: [==, [get, man_made], outfall]
      icon-image: pinhead:triangle_down
      icon-overlap: always
      icon-color:
        - case
        - [ ==, [ get, cso_now ], true ]
        - darkred
        - [ ==, [ get, cso_active ], true ]
        - red
        - [ ==, [ get, cso_recent ], true ]
        - orange
        - green
  extends: https://styles.maprva.org/maptiler-basic.json
controls:
  - type: HTMLControl
    options:
      html: >
        <div id="legend" class="map-legend">
            <h4>CSO Outfalls</h4>
            <div><div class="triangle" style="background: green;"></div>No recent events</div>
            <div><div class="triangle" style="background: orange;"></div>Recent event</div>
            <div><div class="triangle" style="background: red;"></div>Active event</div>
            <div><div class="triangle" style="background: darkred;"></div>Event happening now</div>
            <h4>James River Watch testing sites</h4>
            <div><div class="circle"  style="background-color: red;"></div>E. Coli &gt; 235</div>
            <div><div class="circle"  style="background-color: yellow;"></div>&gt; 100</div>
            <div><div class="circle"  style="background-color: green;"></div>&lt; 100</div>
            <div>Transparency = days since test</div>
        </div>
      css: >
        .map-legend {
            background-color: #fff;
            border-radius: 4px;
            bottom: 30px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.10);
            padding: 10px;
            position: fixed;
            left: 10px;
            z-index: 1;
        }
        .map-legend h4 {
            margin: 10px 0;
        }
        .map-legend div { margin-left: 10px; }
        .map-legend div div {
            display: inline-block;
            margin: 0 10px 0 0;
            height: 10px;
            width: 10px;
        }
        .triangle {
          clip-path: polygon(0% 0%, 100% 0%, 50% 100%); 
        }
        .circle {
          border-radius: 50%;
        }
---
import EsriDump from "https://files.trailstash.net/web-esri-dump.js";

const monthAgo = new Date();
monthAgo.setMonth(monthAgo.getUTCMonth() - 1);

export const source = async () => {
  const esriResp = new Promise((resolve, reject) => {
    const where = `creationdate > TIMESTAMP '${monthAgo.toISOString().slice(0, -5).replace("T", " ")}'`;
      const esri = new EsriDump(
        "https://services7.arcgis.com/9ZKA6C4VwqZYRSvM/ArcGIS/rest/services/River_Watch_data_with_station_locations/FeatureServer/0",
        {
          approach: 'iter',
          params: {
            where,
            geometry: "-77.567939,37.494064,-77.363834,37.598184",
            inSR: 4326,
          },
        },
      );
      
      const data = {
        type: "FeatureCollection",
        features: [],
      };

      esri.fetch();

      esri.on("type", (type) => {
        //Emitted before any data events
        //emits one of
        // - `MapServer'
        // - `FeatureServer'
      });

      esri.on("feature", (feature) => {
        data.features.push(feature);
      });

      esri.on("done", () => {
        resolve(data);
      });

      esri.on("error", reject);
    });

  // fetch all data in parallel
  const resps = await Promise.all([
    fetch(`https://poop.maprva.org/data/cso_overflow.geojson?t=${Date.now()}`),
    fetch(`https://poop.maprva.org/data/water.geojson`),
  ]);
  const [cso, water] = await Promise.all(resps.map(r => r.json()));
  const testResults = await esriResp;

  // get just the latest test results and compute their age
  const latestTestResults = testResults.features.reduce((acc, cur) => {
    if (!cur.properties.name || !cur.properties.creationdate) return acc;
    cur.properties.type = "test";
    cur.properties.age = Math.round((Date.now() - Date.parse(cur.properties.creationdate)) / 1000/60/60/24);
    if (!acc[cur.properties.name] || acc[cur.properties.name]?.properties.creationdate < cur.properties.creationdate) {
      acc[cur.properties.name] = cur;
    }
    return acc;
  }, {});

  const data = {
    type: "FeatureCollection",
    features: [
      ...Object.values(latestTestResults),
      ...cso.features,
      ...water.features,
    ],
  };
  return { type: "geojson", data };
}
