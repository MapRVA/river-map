---
type: geojson
options:
  bounds: [ -77.5, 37.5, -77.3, 37.6 ]
  bearing: -41
  zoom: 12
style:
  layers:
    - type: symbol
      layout:
        icon-image:
          - case
          - [any, 
              [ ==, [ get, cso_recent ], true ],
              [ ==, [ get, cso_now ], true ],
              [ ==, [ get, cso_active ], true ]
            ]
          - emoji:poop
          - emoji:thumbsup
        icon-overlap: always
  extends: https://styles.maprva.org/maptiler-basic.json
---
